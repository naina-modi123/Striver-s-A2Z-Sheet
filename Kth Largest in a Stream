class Solution {
    static ArrayList<Integer> kthLargest(int[] arr, int k) {
        // code here
        int n = arr.length;
        ArrayList<Integer> ans = new ArrayList<>();
        PriorityQueue<Integer> pq = new PriorityQueue<>();
        for(int i=0;i<arr.length;i++){
            pq.add(arr[i]);
            if(pq.size() < k){
                ans.add(-1);
            }else{
                while(pq.size() > k){
                    pq.poll();
                }
                ans.add(pq.peek());
            }
            
        }
        return ans;
    }
}
