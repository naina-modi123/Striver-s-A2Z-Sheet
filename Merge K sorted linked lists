class Solution {
    Node mergeKLists(Node[] arr) {
        // code here
        PriorityQueue<Integer> pq = new PriorityQueue<>();
        for(int i=0;i<arr.length;i++){
            Node curr = arr[i];
            while(curr != null){
                pq.add(curr.data);
                curr = curr.next;
            }
        }
        Node dummy = new Node(-1);
        Node tail = dummy;
        while(pq.size() > 0){
            tail.next = new Node(pq.poll());
            tail = tail.next;
        }
        return dummy.next;
    }
}
