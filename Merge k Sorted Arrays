class Solution {
    public ArrayList<Integer> mergeArrays(int[][] mat) {
        // Code here
        int n = mat.length;
        int m = mat[0].length;
        ArrayList<Integer> ans = new ArrayList<>();
        PriorityQueue<Integer> pq = new PriorityQueue<>();
        for(int i=0;i<n;i++){
            for(int j=0;j<m;j++){
                pq.add(mat[i][j]);
            }
        }
        while(pq.size() > 0){
            ans.add(pq.poll());
        }
        return ans;
    }
}
